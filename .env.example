# Konfigurasi EMQX Cloud (WebSocket Secure untuk Frontend Browser)
VITE_MQTT_URL=wss://example.ala.asia-southeast1.emqxsl.com:8084/mqtt
VITE_MQTT_USERNAME=sdms-dashboard
VITE_MQTT_PASSWORD=ganti_password_dashboard
VITE_MQTT_TOPIC_PREFIX=sdms

# Base URL PHP API di cPanel (default /api saat satu domain)
VITE_API_BASE_URL=/api

# Konfigurasi Simulator CLI Node.js (npm run simulate:mqtt)
MQTT_URL=wss://example.ala.asia-southeast1.emqxsl.com:8084/mqtt
MQTT_USERNAME=sdms-gateway-01
MQTT_PASSWORD=ganti_password_gateway
MQTT_TOPIC_PREFIX=sdms
